<% layout('layouts/boilerplate') %>
<style>
    #filters{
        display: flex;
        align-items: center;  
        overflow-x: auto;       
        flex-wrap: wrap;
    }
    .filter{
        text-align: center;
        margin-right: 2rem;
        margin-top: 2rem;
        cursor: pointer;
        opacity: 0.8;
        text-decoration: none;   
        color: inherit;         
    }
    .filter:hover{
        opacity: 1;
    }
    .filter p{
        font-size: 0.8rem;
    }
    .active-filter {
        opacity: 1;
        border-bottom: 2px solid black;
    }
    .tax-info{
        display:none;
    }
    .tax-toggle{
        border: 1px solid black;
        border-radius: 1rem;
        height: 3rem;
        padding: 1rem;
        display: flex;
        align-items: center;
        margin-left: auto;      /* ← push to far right */
        margin-top: 2rem;       /* ← match filter margin */
        flex-shrink: 0;
        white-space: nowrap;
    }
</style>

<div id="filters">
    <a href="/listings" class="filter <%= !category ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-list"></i></div>
        <p>All</p>
    </a>
    <a href="/listings?category=trending" class="filter <%= category === 'trending' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </a>
    <a href="/listings?category=rooms" class="filter <%= category === 'rooms' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </a>
    <a href="/listings?category=iconic%20cities" class="filter <%= category === 'iconic cities' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic Cities</p>
    </a>
    <a href="/listings?category=mountains" class="filter <%= category === 'mountains' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
    </a>
    <a href="/listings?category=castles" class="filter <%= category === 'castles' ? 'active-filter' : '' %>">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
    </a>
    <a href="/listings?category=amazing%20pools" class="filter <%= category === 'amazing pools' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing Pools</p>
    </a>
    <a href="/listings?category=camping" class="filter <%= category === 'camping' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
    </a>
    <a href="/listings?category=farms" class="filter <%= category === 'farms' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-cow"></i></div>
        <p>Farms</p>
    </a>
    <a href="/listings?category=arctic" class="filter <%= category === 'arctic' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Arctic</p>
    </a>
    <a href="/listings?category=domes" class="filter <%= category === 'domes' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-igloo"></i></div>
        <p>Domes</p>
    </a>
    <a href="/listings?category=boats" class="filter <%= category === 'boats' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-ship"></i></div>
        <p>Boats</p>
    </a>
    <a href="/listings?category=historic" class="filter <%= category === 'historic' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-landmark"></i></div>
        <p>Historic</p>
    </a>

    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">Show Taxes</label>
        </div>
    </div>
</div>

<!-- Search results info -->
<% if(search) { %>
    <div class="mt-3 d-flex align-items-center justify-content-between">
        <p class="mb-0">
            Showing <b><%= listings.length %></b> result(s) for "<b><%= search %></b>"
        </p>
        <a href="/listings" class="btn btn-sm btn-outline-dark">Clear Search</a>
    </div>
<% } %>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% if(listings.length === 0) { %>
        <div class="col-12 text-center mt-5">
            <i class="fa-solid fa-face-sad-tear fa-3x mb-3"></i>
            <% if(search) { %>
                <h4>No listings found for "<%= search %>"</h4>
            <% } else { %>
                <h4>No listings found for "<%= category %>"</h4>
            <% } %>
            <a href="/listings" class="btn btn-dark mt-2">View All Listings</a>
        </div>
    <% } else { %>
        <% for(let listing of listings) { %>
            <a href="/listings/<%= listing._id %>" class="listing-link">
                <div class="card col listing-card">
                    <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem;">
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <p class="card-text">
                            <b><%= listing.title %></b><br>
                            &#8377; <%= listing.price.toLocaleString("en-IN") %> /night
                            <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
                        </p>
                    </div>
                </div>
            </a>
        <% } %>
    <% } %>
</div>

<script>
    let taxSwitch = document.getElementById('switchCheckDefault');
    taxSwitch.addEventListener('click', () => {
        let taxInfo = document.getElementsByClassName('tax-info');
        for(let info of taxInfo){
            if(taxSwitch.checked){
                info.style.display = 'inline';
            } else {
                info.style.display = 'none';
            }
        }
    });
</script>