<% layout('layouts/boilerplate') %>

<div class="row mt-3">

    <!-- TITLE -->
    <div class="col-8 offset-3">
        <b><h3><%= listing.title %></h3></b>
    </div>

    <!-- LISTING CARD -->
    <div class="card col-6 offset-3 show-card listing-card">
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">

        <div class="card-body">
            <p class="card-text"><i>Owned by <%= listing.owner.username %></i></p>
            <p class="card-text">Description: <%= listing.description %></p>
            <p class="card-text">Price: &#8377;<%= listing.price.toLocaleString("en-IN") %></p>
            <p class="card-text">Location: <%= listing.location %></p>
            <p class="card-text">Country: <%= listing.country %></p>
        </div>
    </div>

    <br>

    <!-- EDIT / DELETE -->
    <% if(currentUser && listing.owner._id.equals(currentUser._id)) { %>
    <div class="btns">
        <a href="/listings/<%= listing.id %>/edit" class="btn btn-dark col-1 offset-3 edit-btn">Edit</a>

        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-dark offset-5">Delete</button>
        </form>
    </div>
    <% } %>

    <!-- BOOKING FORM -->
<div class="col-6 offset-3 mt-4 mb-2">
  <div class="card shadow-sm border-0" style="border-radius:16px; overflow:hidden;">

    <div style="background:#fe424d; padding: 1rem 1.5rem;">
      <h5 class="text-white mb-0">
        <i class="fa-solid fa-calendar-check me-2"></i>Reserve this stay
      </h5>
    </div>

    <div class="card-body p-4">
      <p class="fs-5 fw-medium mb-3">
        &#8377;<%= listing.price.toLocaleString("en-IN") %>
        <span class="text-muted fs-6 fw-normal">/ night</span>
      </p>

      <% if(currentUser) { %>
        <% if(currentUser._id.equals(listing.owner._id)) { %>
          <div class="alert alert-secondary py-2" style="border-radius:10px;">
            <i class="fa-solid fa-house me-2"></i>You own this listing.
          </div>
        <% } else { %>
          <form action="/listings/<%= listing._id %>/bookings" method="POST" id="bookingForm">

            <div class="row g-2 mb-3">
              <div class="col-6">
                <label class="form-label text-uppercase" style="font-size:11px;letter-spacing:0.06em;">Check-in</label>
                <input type="date" name="booking[checkIn]" class="form-control" id="checkIn" required />
              </div>
              <div class="col-6">
                <label class="form-label text-uppercase" style="font-size:11px;letter-spacing:0.06em;">Check-out</label>
                <input type="date" name="booking[checkOut]" class="form-control" id="checkOut" required />
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label text-uppercase" style="font-size:11px;letter-spacing:0.06em;">Guests</label>
              <input type="number" name="booking[guests]" class="form-control" min="1" max="20" value="1" required />
            </div>

            <div class="p-3 mb-3 bg-light rounded-3" id="pricePreview" style="display:none;">
              <div class="d-flex justify-content-between mb-1">
                <span class="text-muted" id="nightsLabel"></span>
                <span id="nightsTotal"></span>
              </div>
              <hr class="my-2">
              <div class="d-flex justify-content-between fw-medium">
                <span>Total</span>
                <span id="grandTotal"></span>
              </div>
            </div>

            <button type="submit" class="btn w-100 text-white fw-medium" style="background:#fe424d; border:none; border-radius:10px; padding:0.65rem;">
              Reserve
            </button>

          </form>
        <% } %>
      <% } else { %>
        <a href="/login" class="btn w-100 text-white fw-medium" style="background:#fe424d; border:none; border-radius:10px; padding:0.65rem;">
          <i class="fa-solid fa-right-to-bracket me-2"></i>Login to Reserve
        </a>
      <% } %>

    </div>
  </div>
</div>

<script>
  const pricePerNight = <%= listing.price %>;
  const bookedRanges = <%- JSON.stringify(bookedRanges) %>;
  const today = new Date().toISOString().split('T')[0];

  const checkInInput = document.getElementById('checkIn');
  const checkOutInput = document.getElementById('checkOut');

  if(checkInInput) checkInInput.min = today;
  if(checkOutInput) checkOutInput.min = today;

  function updatePrice() {
    const ci = new Date(checkInInput.value);
    const co = new Date(checkOutInput.value);
    if (!checkInInput.value || !checkOutInput.value || ci >= co) {
      document.getElementById('pricePreview').style.display = 'none';
      return;
    }
    const nights = Math.ceil((co - ci) / (1000 * 60 * 60 * 24));
    const total = nights * pricePerNight;
    document.getElementById('nightsLabel').textContent = `₹${pricePerNight.toLocaleString('en-IN')} × ${nights} night${nights > 1 ? 's' : ''}`;
    document.getElementById('nightsTotal').textContent = `₹${total.toLocaleString('en-IN')}`;
    document.getElementById('grandTotal').textContent = `₹${total.toLocaleString('en-IN')}`;
    document.getElementById('pricePreview').style.display = 'block';
  }

  if(checkInInput) checkInInput.addEventListener('change', () => {
    checkOutInput.min = checkInInput.value;
    updatePrice();
  });
  if(checkOutInput) checkOutInput.addEventListener('change', updatePrice);
</script>

    <!-- REVIEWS -->
    <div class="col-8 offset-3 mb-3">
      

        <% if(currentUser) { %>
          <hr>
        <h4>Leave a Review</h4>

        <form method="POST"
              action="/listings/<%= listing._id %>/reviews"
              novalidate
              class="needs-validation">

            <div class="mb-3 mt-3">
                <label class="form-label">Rating</label>

                <fieldset class="starability-slot">
                    <input type="radio" id="no-rate" class="input-no-rate"
                           name="review[rating]" value="0" checked />

                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1">1 star</label>

                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2">2 stars</label>

                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3">3 stars</label>

                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4">4 stars</label>

                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5">5 stars</label>
                </fieldset>
            </div>

            <div class="mb-3 mt-3">
                <label class="form-label">Comments</label>
                <textarea id="comment"
                          name="review[comment]"
                          rows="4"
                          class="form-control"
                          required></textarea>

                <div class="invalid-feedback">
                    Please add some comments for review
                </div>

                <button type="submit" class="btn btn-outline-dark mt-2">
                    Submit Review
                </button>
            </div>

        </form>

        
        <% } %>

       
<%if(listing.reviews.length >0) { %>
           <div class="row g-3">
         <hr>
           <h4>All Reviews</h4>
            <% for(let review of listing.reviews) { %>
            <div class="col-md-5">
                <div class="card h-100 p-2">
                    <div class="card-body">

                        <h5 class="card-title">@<%= review.author.username %></h5>

                        <p class="starability-result card-text"
                           data-rating="<%= review.rating %>">
                            Rated: <%= review.rating %> stars
                        </p>

                        <p class="card-text"><%= review.comment %></p>

                        <% if(currentUser && review.author && review.author._id.equals(currentUser._id)) { %>
                        <form method="POST"
                              action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                            <button class="btn btn-sm btn-outline-dark">Delete</button>
                        </form>
                        <% } %>

                    </div>
                </div>

            </div>
            <% } %>
            
        </div>
        <% } %>
          

        
    </div>

    <!-- ⭐ MAP AFTER REVIEWS -->
    <div class="col-8 offset-3 mb-4">
     <hr>
        <h4>Where you'll be</h4>

        <div id="map"></div>
    </div>

</div>

<!-- SCRIPT FOR MAP -->
<script>
    const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
    const listingTitle = "<%= listing.title %>";
    const listingLocation = "<%= listing.location %>, <%= listing.country %>";
</script>

<script src="/js/map.js"></script>