<% layout('layouts/boilerplate') %>

<style>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .about-hero {
    background: linear-gradient(135deg, #fe424d 0%, #ff7a7f 100%);
    border-radius: 24px;
    padding: 4rem 2rem;
    text-align: center;
    color: #fff;
    margin-top: 2rem;
    margin-bottom: 3rem;
    position: relative;
    overflow: hidden;
  }
  .about-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 20% 30%, rgba(255,255,255,0.15) 0%, transparent 50%),
                radial-gradient(circle at 80% 70%, rgba(255,255,255,0.12) 0%, transparent 50%);
  }
  .about-hero h1 {
    font-weight: 800;
    font-size: 2.6rem;
    position: relative;
    z-index: 1;
    animation: fadeInUp 0.6s ease backwards;
  }
  .about-hero p {
    font-size: 1.15rem;
    max-width: 600px;
    margin: 1rem auto 0;
    opacity: 0.95;
    position: relative;
    z-index: 1;
    animation: fadeInUp 0.6s ease 0.1s backwards;
  }

  .about-stat {
    text-align: center;
    padding: 1.5rem;
    animation: fadeInUp 0.5s ease backwards;
  }
  .about-stat h3 {
    font-size: 2.2rem;
    font-weight: 800;
    background: linear-gradient(135deg, #fe424d 0%, #ff7a7f 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 4px;
  }
  .about-stat p {
    color: #888;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0;
  }

  .about-feature-card {
    border-radius: 18px;
    border: none;
    padding: 2rem;
    height: 100%;
    background: #fff;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease;
    animation: fadeInUp 0.5s ease backwards;
  }
  .about-feature-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 32px rgba(254,66,77,0.14);
  }
  .about-feature-icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: linear-gradient(135deg, #fe424d 0%, #ff7a7f 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 24px;
    margin-bottom: 1.2rem;
    box-shadow: 0 6px 16px rgba(254,66,77,0.25);
  }

  .about-quote {
    font-family: 'Georgia', serif;
    font-style: italic;
    font-size: 1.6rem;
    text-align: center;
    color: #333;
    max-width: 680px;
    margin: 4rem auto;
    line-height: 1.6;
    position: relative;
  }
  .about-quote::before {
    content: '"';
    font-size: 4rem;
    color: #fe424d;
    opacity: 0.3;
    position: absolute;
    top: -30px;
    left: -10px;
    font-family: Georgia, serif;
  }

  .about-cta {
    background: #fff9f9;
    border: 1.5px dashed #fe424d;
    border-radius: 20px;
    padding: 3rem 2rem;
    text-align: center;
  }

  .btn-cta-fancy {
    background: linear-gradient(135deg, #fe424d 0%, #ff7a7f 100%);
    color: #fff;
    border-radius: 25px;
    padding: 0.7rem 2.2rem;
    font-weight: 600;
    border: none;
    box-shadow: 0 6px 20px rgba(254,66,77,0.3);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    display: inline-block;
    text-decoration: none;
  }
  .btn-cta-fancy:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 26px rgba(254,66,77,0.4);
    color: #fff;
  }
</style>

<div class="container py-4">

  <div class="about-hero">
    <h1><i class="fa-regular fa-compass me-2"></i>About Wanderlust</h1>
    <p>The world is full of stories waiting to be lived — we just help you find your next chapter.</p>
  </div>

  <div class="row justify-content-center mb-5">
    <div class="col-lg-8 text-center">
      <h2 class="fw-bold mb-3">Our story</h2>
      <p class="text-muted" style="font-size:16px;line-height:1.8;">
        Wanderlust was born from a simple belief: travel shouldn't feel like a transaction —
        it should feel like an invitation. We built a platform where hosts share more than a room,
        and travelers find more than a place to sleep. Every listing is a doorway into someone's
        world, and every booking is the start of a story you haven't lived yet.
      </p>
    </div>
  </div>

  <div class="row mb-5">
    <div class="col-6 col-md-3">
      <div class="about-stat" style="animation-delay:0s;">
        <h3>50K+</h3>
        <p>Stays listed</p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="about-stat" style="animation-delay:0.1s;">
        <h3>120+</h3>
        <p>Countries</p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="about-stat" style="animation-delay:0.2s;">
        <h3>2M+</h3>
        <p>Happy travelers</p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="about-stat" style="animation-delay:0.3s;">
        <h3>4.9★</h3>
        <p>Average rating</p>
      </div>
    </div>
  </div>

  <div class="row g-4 mb-5">
    <div class="col-md-4">
      <div class="about-feature-card" style="animation-delay:0s;">
        <div class="about-feature-icon"><i class="fa-solid fa-shield-halved"></i></div>
        <h5 class="fw-bold mb-2">Verified hosts</h5>
        <p class="text-muted mb-0">Every host is vetted so you can book with confidence, wherever your travels take you.</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="about-feature-card" style="animation-delay:0.1s;">
        <div class="about-feature-icon"><i class="fa-solid fa-heart"></i></div>
        <h5 class="fw-bold mb-2">Handpicked stays</h5>
        <p class="text-muted mb-0">From cozy cabins to city lofts, every listing is chosen to feel like somewhere worth remembering.</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="about-feature-card" style="animation-delay:0.2s;">
        <div class="about-feature-icon"><i class="fa-solid fa-headset"></i></div>
        <h5 class="fw-bold mb-2">24/7 support</h5>
        <p class="text-muted mb-0">Our team is always a message away, before, during, and after your trip.</p>
      </div>
    </div>
  </div>

  <div class="about-quote">
    Travel isn't about the miles you cover, it's about the doors you open along the way.
  </div>

  <div class="about-cta">
    <h3 class="fw-bold mb-2">Ready to find your next stay?</h3>
    <p class="text-muted mb-4">Join millions of travelers already exploring the world with Wanderlust.</p>
    <a href="/listings" class="btn-cta-fancy">Explore stays</a>
  </div>

</div>