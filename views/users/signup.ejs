<% layout('layouts/boilerplate') %>
<div class="row mt-3">
     <h2 class="col-6 offset-3">Sign Up on Wanderlust</h2>
    <div class="col-6 offset-3">
        <form action="/signup" method="POST" novalidate class="needs-validation">
           
            <div class="mb-3">
                <lable for="username" class="form-label">Username</lable>
                <input name="username" id="username" placeholder="Enter your username" class="form-control" type="text" required />
                 <div class="valid-feedback">Look's Good</div>
            </div>
          
            <div class="mb-3">
                <lable for="email" class="form-label">Email</lable>
                <input name="email" id="email" placeholder="Enter your email" class="form-control" type="email" required />
                 
            </div>
            <div class="mb-3">
                <lable for="password" class="form-label">Password</lable>
                <input name="password" id="password" placeholder="Enter your password" class="form-control" type="password" required />
                  
            </div>
            <button type="submit" class="btn btn-success">Sign Up</button>


        </form>
     </div> 
     </div> 
