<% layout('layouts/boilerplate') %>
<div class="row mt-3">
     <h2 class="col-6 offset-3">Login to Wanderlust</h2>
    <div class="col-6 offset-3">
        <form action="/login" method="POST" novalidate class="needs-validation">
           
            <div class="mb-3">
                <lable for="username" class="form-label">Username</lable>
                <input name="username" id="username" placeholder="Enter your username" class="form-control" type="text" required />
                 <div class="valid-feedback">Look's Good</div>
            </div>
          
            <div class="mb-3">
                <lable for="password" class="form-label">Password</lable>
                <input name="password" id="password" placeholder="Enter your password" class="form-control" type="password" required />
                  
            </div>
            <button type="submit" class="btn btn-success">Login</button>
        </form>
     </div> 
     </div>
     