<% layout('layouts/boilerplate') %>

<style>
  .profile-wrap {
    max-width: 480px;
    margin: 0 auto;
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    margin-top: 2rem;
    margin-bottom: 3rem;
  }
  .avatar-wrap {
    position: relative;
    width: 110px;
    height: 110px;
    margin: 0 auto;
  }
  .avatar-camera-btn {
    position: absolute;
    bottom: 2px;
    right: 2px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #fe424d;
    color: #fff;
    border: 2px solid #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    font-size: 12px;
  }
</style>

<div class="profile-wrap">

  <!-- Red header -->
  <div style="height:120px; background:#fe424d;"></div>

  <!-- Content -->
  <div class="p-4 text-center" style="margin-top:-55px;">

    <!-- Avatar -->
    <div class="avatar-wrap">
      <% if (user.profileImage && user.profileImage.filename !== 'default-avatar') { %>
        <img src="<%= user.profileImage.url %>" alt="Profile photo"
          class="rounded-circle bg-white border border-3"
          style="width:110px;height:110px;object-fit:cover;border-color:#fff !important;box-shadow:0 4px 16px rgba(0,0,0,0.12);">
      <% } else { %>
        <div class="rounded-circle bg-white border border-3 d-flex align-items-center justify-content-center"
          style="width:110px;height:110px;font-size:38px;font-weight:700;color:#fe424d;border-color:#fff !important;box-shadow:0 4px 16px rgba(0,0,0,0.12);">
          <%= user.username[0].toUpperCase() %>
        </div>
      <% } %>

      <!-- Camera button triggers hidden file input -->
      <div class="avatar-camera-btn" onclick="document.getElementById('photoInput').click()">
        <i class="fa-solid fa-camera"></i>
      </div>
    </div>

    <!-- Hidden upload form, auto-submits on file select -->
    <form id="photoForm" action="/profile/photo" method="POST" enctype="multipart/form-data" style="display:none;">
      <input type="file" id="photoInput" name="profileImage" accept="image/*"
        onchange="document.getElementById('photoForm').submit()">
    </form>

    <h3 class="mt-3 mb-1 fw-bold"><%= user.username %></h3>
    <p class="text-muted mb-4">Wanderlust Explorer</p>

    <!-- Info -->
    <div class="border rounded-4 p-4 text-start mb-4">

      <% if(user.email) { %>
      <div class="mb-3 pb-3 border-bottom">
        <small class="text-muted d-block mb-1" style="font-size:11px;letter-spacing:0.06em;">EMAIL</small>
        <div class="fw-medium" style="font-size:14px;">
          <i class="fa-solid fa-envelope me-2" style="color:#fe424d;"></i><%= user.email %>
        </div>
      </div>
      <% } %>

      <div class="mb-3 pb-3 border-bottom">
        <small class="text-muted d-block mb-1" style="font-size:11px;letter-spacing:0.06em;">USERNAME</small>
        <div class="fw-medium" style="font-size:14px;">
          <i class="fa-solid fa-user me-2" style="color:#fe424d;"></i><%= user.username %>
        </div>
      </div>

      <div class="mb-3 pb-3 border-bottom">
        <small class="text-muted d-block mb-1" style="font-size:11px;letter-spacing:0.06em;">MEMBER SINCE</small>
        <div class="fw-medium" style="font-size:14px;">
          <i class="fa-solid fa-calendar me-2" style="color:#fe424d;"></i>
          <%= new Date(user._id.getTimestamp()).toLocaleDateString('en-IN',{year:'numeric',month:'long',day:'numeric'}) %>
        </div>
      </div>

      <div>
        <small class="text-muted d-block mb-1" style="font-size:11px;letter-spacing:0.06em;">USER ID</small>
        <div style="font-size:11px;color:#bbb;font-family:monospace;word-break:break-all;">
          <i class="fa-solid fa-fingerprint me-2" style="color:#fe424d;"></i><%= user._id %>
        </div>
      </div>

    </div>

    <!-- Bookings summary -->
    <div class="d-flex gap-3 mb-4">
      <div class="flex-fill border rounded-3 p-3 text-center">
        <div style="font-size:22px;font-weight:800;color:#fe424d;"><%= bookings.length %></div>
        <div style="font-size:11px;color:#aaa;text-transform:uppercase;letter-spacing:0.06em;">Bookings</div>
      </div>
      <div class="flex-fill border rounded-3 p-3 text-center">
        <div style="font-size:22px;font-weight:800;color:#22c55e;"><%= bookings.filter(b=>b.status==='confirmed').length %></div>
        <div style="font-size:11px;color:#aaa;text-transform:uppercase;letter-spacing:0.06em;">Confirmed</div>
      </div>
      <div class="flex-fill border rounded-3 p-3 text-center">
        <div style="font-size:22px;font-weight:800;color:#3b82f6;">₹<%= bookings.filter(b=>b.status!=='cancelled').reduce((s,b)=>s+b.totalPrice,0).toLocaleString('en-IN') %></div>
        <div style="font-size:11px;color:#aaa;text-transform:uppercase;letter-spacing:0.06em;">Spent</div>
      </div>
    </div>

    <!-- Actions -->
    <div class="d-flex justify-content-center gap-2">
      <button class="btn btn-outline-dark" onclick="document.getElementById('editModal').classList.add('open')">
        <i class="fa-solid fa-pen me-1"></i> Edit Profile
      </button>
      <a href="/logout" class="btn text-white" style="background:#fe424d;">
        <i class="fa-solid fa-right-from-bracket me-1"></i> Logout
      </a>
    </div>

  </div>
</div>



<!-- Edit modal -->
<div id="editModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:999;align-items:center;justify-content:center;">
  <div style="background:#fff;border-radius:16px;padding:1.75rem;width:100%;max-width:380px;box-shadow:0 20px 60px rgba(0,0,0,0.18);">
    <h3 style="font-size:16px;font-weight:700;margin-bottom:4px;">Edit Username</h3>
    <p style="font-size:13px;color:#999;margin-bottom:1.25rem;">Choose a new unique username.</p>
    <form method="POST" action="/profile/edit">
      <input name="username" value="<%= user.username %>" required
        style="width:100%;padding:9px 13px;border:1.5px solid #e5e5e5;border-radius:9px;font-size:13px;outline:none;margin-bottom:1rem;" />
      <div style="display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" onclick="document.getElementById('editModal').style.display='none'" 
          style="padding:8px 16px;border-radius:9px;border:1.5px solid #ddd;background:#fff;font-size:13px;cursor:pointer;">Cancel</button>
        <button type="submit"
          style="padding:8px 16px;border-radius:9px;border:none;background:#fe424d;color:#fff;font-size:13px;font-weight:500;cursor:pointer;">Save</button>
      </div>
    </form>
  </div>
</div>

<script>
  document.querySelectorAll('[onclick*="editModal"]').forEach(el => {
    el.addEventListener('click', () => {
      document.getElementById('editModal').style.display = 'flex';
    });
  });
</script>