<% layout('layouts/boilerplate') %>

<div class="container py-5">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1">My Bookings</h2>
      <p class="text-muted mb-0">
        Manage your trips and reservations
      </p>
    </div>

```
<a href="/listings"
   class="btn text-white"
   style="background:#fe424d;">
  <i class="fa-regular fa-compass me-1"></i>
  Explore Stays
</a>
```

  </div>

<% if(bookings.length === 0){ %>

```
<div class="card border-0 shadow-sm text-center py-5">
  <i class="fa-solid fa-calendar-xmark mb-3"
     style="font-size:50px;color:#fe424d;"></i>

  <h4>No Bookings Yet</h4>

  <p class="text-muted">
    Start exploring amazing destinations.
  </p>

  <a href="/listings"
     class="btn text-white mx-auto"
     style="background:#fe424d;width:180px;">
    Explore Stays
  </a>
</div>
```

<% } else { %>

```
<div class="row g-4">

  <% bookings.forEach(booking => { %>

    <% if(booking.listing){ %>

    <div class="col-lg-6">

      <div class="card border-0 shadow-sm h-100">

        <img
          src="<%= booking.listing.image.url %>"
          class="card-img-top"
          alt="<%= booking.listing.title %>"
          style="height:220px;object-fit:cover;"
        >

        <div class="card-body">

          <div class="d-flex justify-content-between align-items-start">

            <h5 class="fw-bold mb-2">
              <%= booking.listing.title %>
            </h5>

            <span
              class="badge"
              style="
                background:
                <%= booking.status === 'confirmed'
                    ? '#198754'
                    : booking.status === 'cancelled'
                    ? '#dc3545'
                    : '#fe424d'
                %>;
              "
            >
              <%= booking.status %>
            </span>

          </div>

          <p class="text-muted mb-3">
            <i class="fa-solid fa-location-dot me-1"></i>
            <%= booking.listing.location %>
          </p>

          <div class="row">

            <div class="col-6">
              <small class="text-muted d-block">
                Check In
              </small>

              <strong>
                <%= new Date(booking.checkIn).toDateString() %>
              </strong>
            </div>

            <div class="col-6">
              <small class="text-muted d-block">
                Check Out
              </small>

              <strong>
                <%= new Date(booking.checkOut).toDateString() %>
              </strong>
            </div>

          </div>

          <hr>

          <div class="d-flex justify-content-between align-items-center">

            <div>

              <p class="mb-1">
                <i class="fa-solid fa-user-group me-1"></i>
                <%= booking.guests %> Guest(s)
              </p>

              <h5 class="mb-0 fw-bold">
                ₹<%= booking.totalPrice.toLocaleString('en-IN') %>
              </h5>

            </div>

            <% if(booking.status !== 'cancelled'){ %>

            <form
              method="POST"
              action="/listings/<%= booking.listing._id %>/bookings/<%= booking._id %>/cancel"
            >

              <button
                class="btn btn-outline-danger btn-sm">
                Cancel Booking
              </button>

            </form>

            <% } %>

          </div>

        </div>

      </div>

    </div>

    <% } %>

  <% }) %>

</div>
```

<% } %>

</div>
