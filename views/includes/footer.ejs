        <div style="display:flex;flex-direction:column;gap:10px;">
          <a href="/about" style="color:#aaa;text-decoration:none;font-size:14px;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#aaa'">About Us</a>
          <a href="#" style="color:#aaa;text-decoration:none;font-size:14px;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#aaa'">Careers</a>
          <a href="#" style="color:#aaa;text-decoration:none;font-size:14px;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#aaa'">Press</a>
