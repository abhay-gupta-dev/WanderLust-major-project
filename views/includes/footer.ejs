          <a href="/listings" style="color:#aaa;text-decoration:none;font-size:14px;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#aaa'">All Stays</a>
          <a href="/listings?category=trending" style="color:#aaa;text-decoration:none;font-size:14px;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#aaa'">Trending</a>
