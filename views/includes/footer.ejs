          <a href="https://facebook.com" target="_blank" style="width:36px;height:36px;border-radius:50%;background:#333;display:flex;align-items:center;justify-content:center;color:#fff;text-decoration:none;transition:background 0.2s;" onmouseover="this.style.background='#fe424d'" onmouseout="this.style.background='#333'">
            <i class="fa-brands fa-facebook-f" style="font-size:14px;"></i>
          </a>
          <a href="https://instagram.com" target="_blank" style="width:36px;height:36px;border-radius:50%;background:#333;display:flex;align-items:center;justify-content:center;color:#fff;text-decoration:none;" onmouseover="this.style.background='#fe424d'" onmouseout="this.style.background='#333'">
            <i class="fa-brands fa-instagram" style="font-size:14px;"></i>
          </a>
          <a href="https://linkedin.com" target="_blank" style="width:36px;height:36px;border-radius:50%;background:#333;display:flex;align-items:center;justify-content:center;color:#fff;text-decoration:none;" onmouseover="this.style.background='#fe424d'" onmouseout="this.style.background='#333'">
            <i class="fa-brands fa-linkedin-in" style="font-size:14px;"></i>
          </a>
          <a href="https://twitter.com" target="_blank" style="width:36px;height:36px;border-radius:50%;background:#333;display:flex;align-items:center;justify-content:center;color:#fff;text-decoration:none;" onmouseover="this.style.background='#fe424d'" onmouseout="this.style.background='#333'">
            <i class="fa-brands fa-x-twitter" style="font-size:14px;"></i>
