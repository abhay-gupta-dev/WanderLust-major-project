      <div style="display:flex; gap:6px; align-items:center;">
        <i class="fa-solid fa-globe" style="color:#666; font-size:13px;"></i>
        <span style="color:#666; font-size:13px;">India</span>
        <span style="color:#444; margin:0 6px;">·</span>
        <span style="color:#666; font-size:13px;">&#8377; INR</span>
      </div>
